#!/usr/bin/python3 -I
"""Privileged nginx helper for ProxOrchestrator.

Installed root:root 0755 at /usr/local/sbin/proxorchestrator-nginx-helper and
the ONLY command the service user may run through sudo. Every argument is
validated and every file it writes is generated from fixed templates, so a
compromised application account cannot inject arbitrary nginx directives
(which would otherwise be a path to root, e.g. via access_log to any file).

Subcommands:
  test                       nginx -t
  reload                     nginx -t && nginx -s reload
  set-port PORT              change the HTTPS listen port of the main site
  write-ws HOST PORT         write the console proxy include; reads the API
                             token as "TOKEN_ID\\nTOKEN_SECRET" from stdin
  clear-ws                   empty the console proxy include
  acme-on | acme-off         enable/disable the port-80 HTTP-01 server
"""

import ipaddress
import os
import re
import subprocess
import sys
import tempfile

CONF_DIR = "/etc/proxorchestrator/nginx"
WS_CONF = os.path.join(CONF_DIR, "proxmox_ws.conf")
ACME_CONF = os.path.join(CONF_DIR, "acme-challenge.conf")
SITE_CONFS = (
    "/etc/nginx/sites-available/proxorchestrator",
    "/etc/nginx/conf.d/proxorchestrator.conf",
)
NGINX = "/usr/sbin/nginx"

HOSTNAME_RE = re.compile(
    r"^(?=.{1,253}$)([A-Za-z0-9]([A-Za-z0-9\-]{0,61}[A-Za-z0-9])?)"
    r"(\.[A-Za-z0-9]([A-Za-z0-9\-]{0,61}[A-Za-z0-9])?)*$"
)
TOKEN_ID_RE = re.compile(r"^[A-Za-z0-9._\-]{1,64}@[A-Za-z0-9._\-]{1,64}![A-Za-z0-9._\-]{1,64}$")
TOKEN_SECRET_RE = re.compile(r"^[A-Za-z0-9\-]{8,128}$")

WS_TEMPLATE = """\
# Generated by proxorchestrator-nginx-helper — do not edit.
# Every console handshake is authorised by Django before the Proxmox API
# token below is attached; nothing else under /vm-ws/ is proxied.
location = /_po_console_auth {{
    internal;
    proxy_pass              http://proxorchestrator_app/internal/console-auth/;
    proxy_pass_request_body off;
    proxy_set_header        Content-Length "";
    proxy_set_header        X-Original-URI $request_uri;
    proxy_set_header        Host $http_host;
    proxy_set_header        X-Forwarded-Proto $scheme;
    proxy_set_header        X-Real-IP $remote_addr;
}}

location ~ ^/vm-ws/nodes/[A-Za-z0-9][A-Za-z0-9.\\-]*/(qemu|lxc)/[0-9]+/vncwebsocket$ {{
    limit_except GET {{ deny all; }}
    auth_request        /_po_console_auth;
    rewrite             ^/vm-ws/(.*)$ /api2/json/$1 break;
    proxy_pass          https://{host}:{port};
    proxy_http_version  1.1;
    proxy_set_header    Upgrade    $http_upgrade;
    proxy_set_header    Connection "upgrade";
    proxy_set_header    Host       {host_header};
    proxy_set_header    Authorization "PVEAPIToken={token_id}={token_secret}";
    proxy_set_header    Cookie     "";
    proxy_ssl_verify    off;
    proxy_read_timeout  600s;
    proxy_send_timeout  600s;
}}

location /vm-ws/ {{
    return 404;
}}
"""

ACME_BLOCK = """\
# Generated by proxorchestrator-nginx-helper — do not edit.
server {
    listen 80;
    server_name _;
    location /.well-known/acme-challenge/ {
        alias /opt/proxorchestrator/certs/acme-challenge/;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}
"""

EMPTY = "# Generated by proxorchestrator-nginx-helper — intentionally empty.\n"


def die(msg, code=2):
    print(f"proxorchestrator-nginx-helper: {msg}", file=sys.stderr)
    sys.exit(code)


def run(*args):
    return subprocess.run(args, capture_output=True, text=True)


def nginx_test():
    res = run(NGINX, "-t")
    if res.returncode != 0:
        sys.stderr.write(res.stderr)
    return res.returncode == 0


def atomic_write(path, content, mode=0o600):
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, "w") as f:
            f.write(content)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def write_checked(path, content, mode=0o600):
    """Write content, roll back if nginx -t fails."""
    previous = None
    if os.path.exists(path):
        with open(path) as f:
            previous = f.read()
    atomic_write(path, content, mode)
    if not nginx_test():
        if previous is None:
            os.unlink(path)
        else:
            atomic_write(path, previous, mode)
        die("nginx -t failed; change rolled back", 1)


def valid_host(value):
    try:
        ip = ipaddress.ip_address(value)
        return f"[{ip}]" if ip.version == 6 else str(ip)
    except ValueError:
        pass
    if HOSTNAME_RE.match(value):
        return value
    die("invalid host")


def valid_port(value):
    if not value.isdigit() or not 1 <= int(value) <= 65535:
        die("invalid port")
    return int(value)


def cmd_write_ws(host, port):
    host = valid_host(host)
    port = valid_port(port)
    data = sys.stdin.read(1024).splitlines()
    if len(data) != 2:
        die("expected token id and secret on stdin")
    token_id, token_secret = data[0].strip(), data[1].strip()
    if not TOKEN_ID_RE.match(token_id) or not TOKEN_SECRET_RE.match(token_secret):
        die("invalid API token format")
    content = WS_TEMPLATE.format(
        host=host, port=port, host_header=f"{host}:{port}",
        token_id=token_id, token_secret=token_secret,
    )
    write_checked(WS_CONF, content)


def cmd_set_port(port):
    port = valid_port(port)
    site = next((p for p in SITE_CONFS if os.path.exists(p)), None)
    if not site:
        die("nginx site config not found")
    with open(site) as f:
        original = f.read()
    updated, n = re.subn(r"(?m)^(\s*listen\s+)\d+(\s+ssl)", rf"\g<1>{port}\2", original)
    if n == 0:
        die("listen directive not found")
    write_checked(site, updated, 0o644)


def main(argv):
    if os.geteuid() != 0:
        die("must run as root (via sudo)")
    if not argv:
        die("missing subcommand")
    cmd, args = argv[0], argv[1:]
    if cmd == "test" and not args:
        sys.exit(0 if nginx_test() else 1)
    elif cmd == "reload" and not args:
        if not nginx_test():
            die("nginx -t failed; not reloading", 1)
        res = run(NGINX, "-s", "reload")
        sys.stderr.write(res.stderr)
        sys.exit(res.returncode)
    elif cmd == "set-port" and len(args) == 1:
        cmd_set_port(args[0])
    elif cmd == "write-ws" and len(args) == 2:
        cmd_write_ws(args[0], args[1])
    elif cmd == "clear-ws" and not args:
        write_checked(WS_CONF, EMPTY)
    elif cmd == "acme-on" and not args:
        write_checked(ACME_CONF, ACME_BLOCK)
    elif cmd == "acme-off" and not args:
        write_checked(ACME_CONF, EMPTY)
    else:
        die("unknown subcommand or wrong arguments")


if __name__ == "__main__":
    main(sys.argv[1:])
