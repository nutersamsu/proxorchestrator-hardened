#: apps/certificates/views.py:515
#, python-format
msgid ""
"ACME account registered, but DNS API test failed: %(exc)s. Check your API "
"credentials and try again."
msgstr ""
"Conta ACME registrada, mas o teste da API de DNS falhou: %(exc)s. Confira as"
" credenciais da API e tente de novo."

#: apps/certificates/views.py:539
#, python-format
msgid ""
"ACME configured with %(value)s. Certificate issuance started automatically."
