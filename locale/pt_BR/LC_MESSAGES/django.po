msgid "PEM-encoded CA certificate for verifying the ACME server's TLS."
msgstr "Certificado da CA em PEM para verificar o TLS do servidor ACME."

#: apps/certificates/models.py:116
msgid "Disable TLS verification for the ACME server. Testing only."
msgstr "Desativa a verificação TLS do servidor ACME. Só para testes."

#: apps/certificates/views.py:101
msgid "Common Name (CN) is required."
msgstr "O Common Name (CN) é obrigatório."

#: apps/certificates/views.py:137
#, python-format
msgid "Skipped invalid IP SAN: %(ip_str)s"
msgstr "SAN de IP inválido ignorado: %(ip_str)s"

#: apps/certificates/views.py:165
#, python-format
msgid ""
"CSR generated for %(cn)s. Submit it to your CA, then upload the signed "
"certificate."
msgstr ""
"CSR gerado para %(cn)s. Envie-o à sua CA e depois envie o certificado "
"assinado."

