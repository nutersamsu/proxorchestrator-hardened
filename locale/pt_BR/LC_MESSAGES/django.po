msgid "Contact email for the ACME account. Required by Let's Encrypt."
msgstr "E-mail de contato da conta ACME. Exigido pelo Let's Encrypt."

#: apps/certificates/models.py:94
msgid "API token for the DNS provider."
msgstr "Token da API do provedor de DNS."

#: apps/certificates/models.py:98
msgid "API secret (Route 53 secret key, GoDaddy API secret)."
msgstr ""
"Segredo da API (chave secreta do Route 53, segredo da API do GoDaddy)."

#: apps/certificates/models.py:102
msgid "Zone ID or hosted zone ID (Cloudflare, Route 53, Azure)."
msgstr "ID da zona ou da hosted zone (Cloudflare, Route 53, Azure)."

