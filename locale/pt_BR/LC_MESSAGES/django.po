msgstr ""
"Registro DNS TXT gerado. Crie o registro no seu provedor de DNS e depois "
"clique no botão de confirmar."

#: apps/certificates/views.py:655
msgid "All authorizations valid. Issuing certificate..."
msgstr "Todas as autorizações são válidas. Emitindo o certificado..."

#: apps/certificates/views.py:659
#, python-format
msgid "Failed to create order: %(exc)s"
msgstr "Falha ao criar o pedido: %(exc)s"

#: apps/certificates/views.py:714
msgid ""
"DNS confirmed. Certificate issuance in progress — this may take a minute."
msgstr ""
"DNS confirmado. Emissão do certificado em andamento — pode levar um minuto."

#: apps/certificates/views.py:727
msgid "ACME automation disabled. Current certificate is unchanged."
msgstr "Automação ACME desativada. O certificado atual não foi alterado."

#: apps/certificates/views.py:760
msgid "ACME configuration reset. You can now reconfigure."
msgstr "Configuração ACME redefinida. Agora você pode configurar de novo."

