#: templates/emailconfig/settings.html:372
msgid "Application (Client) ID"
msgstr "ID do aplicativo (cliente)"

#: apps/authconfig/models.py:102
msgid "Allowed Domains"
msgstr "Domínios permitidos"

#: apps/authconfig/models.py:103
msgid ""
"Comma-separated list of allowed email domains. Leave blank to allow any "
"Microsoft account."
msgstr ""
"Lista de domínios de e-mail permitidos, separados por vírgula. Deixe em "
"branco para permitir qualquer conta Microsoft."

#: apps/authconfig/models.py:108
msgid "Required Group Object ID"
msgstr "Object ID do grupo obrigatório"

#: apps/authconfig/models.py:109
msgid ""
"Azure AD group Object ID required for login. Leave blank to allow all tenant"
" users (or only the Admin Group if one is set)."
msgstr ""
"Object ID do grupo do Azure AD exigido para entrar. Deixe em branco para "
"permitir todos os usuários do locatário (ou só o grupo de administradores, "
"se houver um)."

#: apps/authconfig/models.py:114
msgid "Admin Group Object ID"
msgstr "Object ID do grupo de administradores"

#: apps/authconfig/models.py:115
msgid "Azure AD group Object ID whose members receive Django admin access."
msgstr ""
"Object ID do grupo do Azure AD cujos membros recebem acesso de administrador"
" no Django."

#: apps/authconfig/models.py:119 templates/authconfig/settings.html:332
msgid "Enable Entra ID Authentication"
msgstr "Ativar autenticação Entra ID"

#: apps/authconfig/views.py:97
msgid "LDAP settings saved."
msgstr "Configurações de LDAP salvas."

#: apps/authconfig/views.py:107
msgid ""
"Enter your organisation's tenant ID (GUID) or primary domain. 'common', "
"'organizations' and 'consumers' are not allowed because they would let any "
"Microsoft account sign in."
msgstr ""
"Informe o ID do locatário (GUID) ou o domínio principal da sua organização. "
"'common', 'organizations' e 'consumers' não são permitidos porque deixariam "
"qualquer conta Microsoft entrar."

