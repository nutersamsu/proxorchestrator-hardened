#: templates/exporter/index.html:29
msgid ""
"Export VMs as versioned, compressed archives ready for long-term storage or "
"sharing."
msgstr ""
"Exporte VMs como arquivos compactados e versionados, prontos para guardar "
"por muito tempo ou compartilhar."

#: templates/exporter/index.html:35
msgid "Cloud Export"
