SECRET_KEY=generate-with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=False
# Host names / IPs used to reach ProxOrchestrator (no wildcard).
ALLOWED_HOSTS=proxorchestrator.lan,192.168.1.50
# Base URL used in password-reset emails.
PUBLIC_BASE_URL=https://proxorchestrator.lan:8443
WEB_PORT=8443
DB_PATH=/opt/proxorchestrator/db.sqlite3
UPLOAD_ROOT=/opt/proxorchestrator/uploads
FIELD_ENCRYPTION_KEY=generate-with: python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CACHE_URL=redis://127.0.0.1:6379/2
# SECURE_HSTS_SECONDS=31536000   # enable once a trusted certificate is installed
